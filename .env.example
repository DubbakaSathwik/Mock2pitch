# --- Public (safe in browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=           # or publishable key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server only (Next.js server / Netlify env; NEVER NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=
INTERNAL_TRANSCRIBE_SECRET=               # only if gRPC Option B (Next.js transcribe route) is used

# --- Supabase Edge Function secrets (`supabase secrets set --env-file`; mirrored here for `supabase functions serve --env-file`) ---
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected by the platform.
INTERNAL_FUNCTION_SECRET=                 # shared secret for function->function and pg_cron->function calls
APP_ALLOWED_ORIGINS=http://localhost:3000,https://<netlify-site>.netlify.app
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=                                # private bucket for this environment
NVIDIA_SLIDE_MODEL=meta/llama-3.2-11b-vision-instruct   # live-tested 2026-10-14 (Llama 4 Maverick is retired: HTTP 410)
NVIDIA_SLIDE_KEY_PRIMARY=
NVIDIA_SLIDE_KEY_FALLBACK_1=
NVIDIA_SLIDE_KEY_FALLBACK_2=
NVIDIA_ASR_FUNCTION_ID=                   # Riva function id from build.nvidia.com (Parakeet TDT 0.6B v2)
NVIDIA_ASR_MODEL_LABEL=parakeet-tdt-0.6b-v2
NVIDIA_ASR_KEY_PRIMARY=
NVIDIA_ASR_KEY_FALLBACK_1=
NVIDIA_ASR_KEY_FALLBACK_2=
NVIDIA_REPORT_MODEL=nvidia/nemotron-3-ultra-550b-a55b       # confirmed live 2026-10-14
NVIDIA_REPORT_KEY_PRIMARY=
NVIDIA_REPORT_KEY_FALLBACK_1=
NVIDIA_REPORT_KEY_FALLBACK_2=
NVIDIA_KEY_RPM_SOFT_LIMIT=35              # route to fallback when a key reaches this many requests/minute
NVIDIA_KEY_DEFAULT_CREDIT_LIMIT=1000      # used for admin "remaining" bars (NVIDIA has no balance API)

# --- Google OAuth (configured in Supabase dashboard / config.toml; listed for documentation) ---
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# --- Test-only (never set in hosted envs) ---
# RUN_LIVE_AI_TESTS=1
# R2 integration tests use the R2_* vars above pointed at a DEV bucket.
