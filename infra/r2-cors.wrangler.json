{
  "rules": [
    {
      "allowed": {
        "origins": ["http://localhost:3000", "https://REPLACE-WITH-NETLIFY-SITE.netlify.app"],
        "methods": ["PUT", "GET", "HEAD"],
        "headers": ["Content-Type", "Content-Length"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
